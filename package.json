{
  "name": "website-diff",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser-based Website Content Diff and Comparison Tool — compare two versions of text or HTML entirely in your browser.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "verify:e2e": "node scripts/e2e-verify.mjs"
  },
  "dependencies": {
    "diff": "^5.2.0",
    "dompurify": "^3.2.4",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "playwright": "^1.65.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
